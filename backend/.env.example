# Required — Gemini API key (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=

# Optional — override the Gemini models (primary is tried first, then fallback)
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Recommended in production — Postgres connection string so data survives restarts.
# Free options: Neon, Supabase, Render Postgres. Leave empty to use local SQLite.
# DATABASE_URL=postgresql://user:password@host/dbname

# Recommended in production — Clerk secret key; locks admin endpoints to users
# whose Clerk public metadata has {"role": "admin"}. Leave empty for local dev.
# CLERK_SECRET_KEY=sk_live_...

# Optional — comma-separated list of allowed frontend origins (default: *)
# ALLOWED_ORIGINS=https://campus-problem-solver.vercel.app,http://localhost:5173
